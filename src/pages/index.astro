---
/**
 * Home — DESIGN_SYSTEM.md §8.
 * Nav · Hero · Showcase · Work · Pricing · Book a Call · Footer.
 * Phase 4: static layout. Interactivity (Phase 6) and motion (Phase 7) come next.
 */
import Base from '../layouts/Base.astro';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/home/Hero.astro';
import ShowcaseGallery from '../components/home/ShowcaseGallery.astro';
import WorkSection from '../components/home/WorkSection.astro';
import Pricing from '../components/home/Pricing.astro';
import BookCall from '../components/home/BookCall.astro';
import ProjectModal from '../components/home/ProjectModal.astro';
import { getProjects, getSettings, getPricing, padCount } from '../lib/content';

const projects = await getProjects();
const settings = await getSettings();
const pricing = await getPricing();
const worksCount = padCount(projects.length);

const featured = projects.filter((p) => p.data.showcase === 'featured');
const more = projects.filter((p) => p.data.showcase === 'more');
---

<Base title="Emon Arefin — Product Designer & Photographer" description={settings.siteDescription}>
  <Nav worksCount={worksCount} overlay />
  <main>
    <Hero worksCount={worksCount} />
    <ShowcaseGallery featured={featured} more={more} />
    <WorkSection projects={projects} />
    {/* TEMPORARY comparison (Emon, 2026-11-09): same section at full page width. Remove the one you don't keep. */}
    <WorkSection projects={projects} id="work-full" fullWidth />
    <Pricing plans={pricing.plans} />
    <BookCall email={settings.email} calLink={settings.calLink} />
  </main>
  {projects.map((p, i) => <ProjectModal project={p} index={i + 1} total={projects.length} />)}
  <Footer />
</Base>
