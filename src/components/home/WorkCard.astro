---
/**
 * Work Card — DESIGN_SYSTEM.md §5.7 / BUILD_PROMPT.md §6.6. Figma: Work Card.
 * The whole card is one <button> that opens the Project Modal (data-open-project).
 * Hover (real pointers) + keyboard focus, var(--m-card-time, 350ms) var(--m-card-ease, ease-out): the image grows to fill the tile,
 * a 1px inside outline appears, a frosted overlay fades in and "View Project" + Arrow Button rise 16px.
 * Hovering anywhere on the card also plays the Arrow Button's own hover (brand fill + arrow swap).
 */
import Media from '../ui/Media.astro';
import ArrowButton from '../ui/ArrowButton.astro';
import type { Project } from '../../lib/content';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const { title, tags, thumbnail, category } = project.data;
---

<button
  class="work-card arrow-trigger"
  type="button"
  data-category={category}
  data-open-project={project.id}
  aria-haspopup="dialog"
  aria-label={`View project: ${title}`}
>
  <span class="work-card__tile" data-reveal>
    <span class="work-card__image">
      <Media
        media={thumbnail}
        widths={[350, 520, 700, 900, 1200]}
        sizes="(min-width: 1600px) 33vw, (min-width: 810px) 50vw, 100vw"
      />
    </span>
    <span class="work-card__overlay" aria-hidden="true">
      <span class="work-card__view">
        <span class="work-card__view-label">View Project</span>
        <ArrowButton />
      </span>
    </span>
  </span>
  <span class="work-card__meta">
    <span class="work-card__title t-body t-medium" data-reveal>{title}</span>
    {
      tags.length > 0 && (
        <span class="work-card__tags t-caption">
          {tags.map((t) => (
            <span class="work-card__tag" data-reveal>{t}</span>
          ))}
        </span>
      )
    }
  </span>
</button>

<style>
  .work-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
    text-align: left;
    color: var(--text-primary);
  }

  .work-card__tile {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 676 / 485;
    background: var(--bg-secondary);
    overflow: hidden;
    --inset-y: 16px;
    --inset-x: 12px;
  }
  @media (min-width: 1024px) {
    .work-card__tile { --inset-y: 32px; --inset-x: 24px; }
  }
  .work-card__image {
    position: absolute;
    inset: var(--inset-y) var(--inset-x);
    transition: inset var(--m-card-time, 350ms) var(--m-card-ease, ease-out);
  }

  /* 1px inside outline (shown on hover) */
  .work-card__tile::after {
    content: "";
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 var(--border-width, 1px) var(--border-subtle);
    opacity: 0;
    transition: opacity var(--m-card-time, 350ms) var(--m-card-ease, ease-out);
    pointer-events: none;
  }

  /* Frosted overlay with "View Project" — only on devices that can hover. */
  .work-card__overlay {
    position: absolute;
    inset: 0;
    display: none;
    place-items: center;
    background: var(--surface-overlay);
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    opacity: 0;
    transition: opacity var(--m-card-time, 350ms) var(--m-card-ease, ease-out);
  }
  .work-card__view {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    transform: translateY(16px);
    transition: transform var(--m-card-time, 350ms) var(--m-card-ease, ease-out);
  }
  .work-card__view-label {
    font-size: var(--font-size-h5);
    line-height: var(--line-height-h5);
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--text-primary);
  }

  @media (hover: hover) and (pointer: fine) {
    .work-card__overlay { display: grid; }
    .work-card:hover .work-card__image,
    .work-card:focus-visible .work-card__image { inset: 0; }
    .work-card:hover .work-card__tile::after,
    .work-card:focus-visible .work-card__tile::after,
    .work-card:hover .work-card__overlay,
    .work-card:focus-visible .work-card__overlay { opacity: 1; }
    .work-card:hover .work-card__view,
    .work-card:focus-visible .work-card__view { transform: none; }
  }
  .work-card__image :global(img),
  .work-card__image :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .work-card__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
  @media (min-width: 1024px) {
    .work-card__meta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }
  }

  .work-card__tags {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text-secondary);
    white-space: nowrap;
  }
  /* 1×14 divider between tags */
  .work-card__tag + .work-card__tag::before {
    content: "";
    display: inline-block;
    width: var(--border-width, 1px);
    height: 14px;
    margin-right: 10px;
    vertical-align: -2px;
    background: var(--border-secondary);
  }
</style>
