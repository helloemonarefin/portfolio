---
/**
 * Work Card — DESIGN_SYSTEM.md §5.7 / BUILD_PROMPT.md §6.6. Figma: Work Card.
 * The whole card is one <button> that opens the Project Modal (data-open-project).
 * Hover overlay + image grow are added in Phase 7.
 */
import Media from '../ui/Media.astro';
import type { Project } from '../../lib/content';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const { title, tags, thumbnail, category } = project.data;
---

<button
  class="work-card"
  type="button"
  data-category={category}
  data-open-project={project.id}
  aria-haspopup="dialog"
  aria-label={`View project: ${title}`}
>
  <span class="work-card__tile">
    <span class="work-card__image">
      <Media
        media={thumbnail}
        widths={[350, 700, 676, 1352]}
        sizes="(min-width: 1024px) 676px, (min-width: 768px) 50vw, 100vw"
      />
    </span>
  </span>
  <span class="work-card__meta">
    <span class="work-card__title t-body t-medium">{title}</span>
    {
      tags.length > 0 && (
        <span class="work-card__tags t-caption">
          {tags.map((t) => (
            <span class="work-card__tag">{t}</span>
          ))}
        </span>
      )
    }
  </span>
</button>

<style>
  .work-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
    text-align: left;
    color: var(--text-primary);
  }

  .work-card__tile {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 676 / 485;
    background: var(--bg-secondary);
    overflow: hidden;
    --inset-y: 16px;
    --inset-x: 12px;
  }
  @media (min-width: 1024px) {
    .work-card__tile { --inset-y: 32px; --inset-x: 24px; }
  }
  .work-card__image {
    position: absolute;
    inset: var(--inset-y) var(--inset-x);
  }
  .work-card__image :global(img),
  .work-card__image :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .work-card__meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }
  @media (min-width: 1024px) {
    .work-card__meta {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }
  }

  .work-card__tags {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text-secondary);
    white-space: nowrap;
  }
  /* 1×14 divider between tags */
  .work-card__tag + .work-card__tag::before {
    content: "";
    display: inline-block;
    width: 1px;
    height: 14px;
    margin-right: 10px;
    vertical-align: -2px;
    background: var(--border-secondary);
  }
</style>
