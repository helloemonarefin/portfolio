---
/**
 * Book a Call — DESIGN_SYSTEM.md §5.9 / BUILD_PROMPT.md §6.9. Figma: Book a Call.
 * Cal.com inline embed (official snippet), loaded only when the section nears the viewport.
 * A calm placeholder shows until the calendar is ready.
 */
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  email: string;
  calLink: string;
}
const { email, calLink } = Astro.props;

const meta = [
  { icon: 'clock', text: '30 min · Google Meet' },
  { icon: 'map-pin', text: 'Based in Bangladesh · GMT+6' },
  { icon: 'message-square', text: 'Replies within 24 hours' },
] as const;
---

<section id="book" class="section book" aria-labelledby="book-title">
  <div class="container section__inner">
    <SectionHeader title="Let’s build something great." id="book-title">
      <ul class="book__meta" role="list">
        {
          meta.map((m) => (
            <li class="book__meta-item t-body-sm" data-reveal>
              <Icon name={m.icon} />
              {m.text}
            </li>
          ))
        }
      </ul>
    </SectionHeader>

    <div class="book__body">
      {
        calLink && (
          <div class="book__embed" data-cal-link={calLink} data-reveal>
            <div class="book__placeholder" data-cal-placeholder>
              <Icon name="calendar" />
              <p class="t-h5">Loading calendar…</p>
            </div>
            <div class="book__cal" id="cal-inline" data-cal-target />
          </div>
        )
      }

      {
        email && (
          <p class="book__email t-body" data-reveal>
            <span class="book__email-muted">Prefer email?</span>
            <a href={`mailto:${email}`}>{email}</a>
          </p>
        )
      }
    </div>
  </div>
</section>

<script>
  // Cal.com inline embed — based on the official snippet from Cal.com (Embed → Inline).
  // https://cal.com/docs/core-features/embed
  type CalFn = ((...args: unknown[]) => void) & { ns: Record<string, (...args: unknown[]) => void> };

  const NS = 'book';

  function loadCal() {
    /* eslint-disable */
    (function (C: any, A: string, L: string) {
      const p = function (a: any, ar: any) { a.q.push(ar); };
      const d = C.document;
      C.Cal = C.Cal || function () {
        const cal = C.Cal; const ar = arguments;
        if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement('script')).src = A; cal.loaded = true; }
        if (ar[0] === L) {
          const api: any = function () { p(api, arguments); };
          const namespace = ar[1]; api.q = api.q || [];
          if (typeof namespace === 'string') { cal.ns[namespace] = cal.ns[namespace] || api; p(cal.ns[namespace], ar); p(cal, ['initNamespace', namespace]); }
          else p(cal, ar);
          return;
        }
        p(cal, ar);
      };
    })(window, 'https://app.cal.com/embed/embed.js', 'init');
    /* eslint-enable */
  }

  for (const box of document.querySelectorAll<HTMLElement>('[data-cal-link]')) {
    const calLink = box.dataset.calLink!;
    const start = () => {
      loadCal();
      const Cal = (window as unknown as { Cal: CalFn }).Cal;
      Cal('init', NS, { origin: 'https://app.cal.com' });
      const api = Cal.ns[NS]!;
      api('inline', {
        elementOrSelector: '#cal-inline',
        calLink,
        config: { layout: 'month_view', useSlotsViewOnSmallScreen: 'true', theme: 'light' },
      });
      api('ui', {
        theme: 'light',
        hideEventTypeDetails: false,
        layout: 'month_view',
        cssVarsPerTheme: { light: { 'cal-brand': '#162026' } },
      });
      api('on', {
        action: 'linkReady',
        callback: () => box.classList.add('is-loaded'),
      });
    };

    // Load only when the section comes near the viewport.
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          start();
        }
      },
      { rootMargin: '600px 0px' },
    );
    io.observe(box);
  }
</script>

<style>
  .book { background: var(--bg-primary); }

  .book__meta {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
  }
  @media (min-width: 1024px) {
    .book__meta { flex-direction: row; gap: 24px; }
  }
  .book__meta-item {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .book__body {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  @media (min-width: 1024px) {
    .book__body { gap: 48px; }
  }

  .book__embed {
    position: relative;
    height: 620px;
    border-radius: 0; /* sharp edges (2026-11-09) */
    background: var(--bg-secondary);
    border: 1px dashed var(--border-secondary);
    overflow: hidden;
  }
  @media (min-width: 1024px) {
    .book__embed { height: 680px; }
  }
  .book__placeholder {
    position: absolute;
    inset: 0;
    transition: opacity 300ms ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    color: var(--text-tertiary);
  }
  .book__placeholder p { color: var(--text-primary); }
  .book__cal {
    position: relative;
    height: 100%;
    overflow: auto;
  }
  .book__embed.is-loaded { border-style: solid; border-color: transparent; }
  .book__embed.is-loaded .book__placeholder { opacity: 0; pointer-events: none; }

  .book__email {
    display: flex;
    flex-wrap: wrap;
    column-gap: 6px;
  }
  .book__email-muted { color: var(--text-secondary); }
  .book__email a {
    color: var(--text-primary);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
