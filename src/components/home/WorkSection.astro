---
/**
 * Work section — DESIGN_SYSTEM.md §5.6–5.7 / BUILD_PROMPT.md §6.6. Figma: Work.
 * Filter chips filter the grid client-side by data-category (fade 200ms, then leave the layout).
 */
import SectionHeader from '../ui/SectionHeader.astro';
import WorkCard from './WorkCard.astro';
import { categoryLabels, type Project } from '../../lib/content';

interface Props {
  projects: Project[];
  /** Section id (anchor). The main one is "work". */
  id?: string;
  /** Let the content run the full page width (side padding matches the nav: 20 / 48px). */
  fullWidth?: boolean;
  /** Desktop columns (2 by default). */
  columns?: 2 | 3;
}
const { projects, id = 'work', fullWidth = false, columns = 2 } = Astro.props;

const filters = [{ value: 'all', label: 'All' }, ...Object.entries(categoryLabels).map(([value, label]) => ({ value, label }))];
---

<section id={id} class="section work" aria-labelledby={`${id}-title`} data-work-section>
  <div class:list={['container', 'section__inner', { 'container--full': fullWidth }]}>
    <SectionHeader title="Real work. Real impact." id={`${id}-title`}>
      <div class="filters" role="group" aria-label="Filter projects">
        {
          filters.map((f) => (
            <button class="chip t-label" type="button" data-reveal data-filter={f.value} aria-pressed={f.value === 'all' ? 'true' : 'false'}>
              {f.label}
            </button>
          ))
        }
      </div>
    </SectionHeader>

    <ul class:list={['work__grid', { 'work__grid--3': columns === 3 }]} role="list">
      {
        projects.map((p) => (
          <li class="work__item" data-category={p.data.category}>
            <WorkCard project={p} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  const FADE = 200;
  for (const section of document.querySelectorAll<HTMLElement>('[data-work-section]')) {
    const chips = [...section.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const items = [...section.querySelectorAll<HTMLElement>('.work__item')];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timer: number | undefined;

    const apply = (filter: string) => {
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === filter)));
      const show = (el: HTMLElement) => filter === 'all' || el.dataset.category === filter;
      window.clearTimeout(timer);

      // 1) fade out the ones that should go (and undo a half-finished fade on the ones that stay)
      items.forEach((el) => el.classList.toggle('is-fading', !show(el)));
      // 2) after the fade, remove them from the layout and fade the rest in
      timer = window.setTimeout(() => {
        const appearing = items.filter((el) => el.hidden && show(el));
        appearing.forEach((el) => el.classList.add('is-fading'));
        items.forEach((el) => (el.hidden = !show(el)));
        requestAnimationFrame(() =>
          requestAnimationFrame(() => appearing.forEach((el) => el.classList.remove('is-fading'))),
        );
      }, reduce ? 0 : FADE);
    };

    chips.forEach((chip) => chip.addEventListener('click', () => apply(chip.dataset.filter ?? 'all')));
  }
</script>

<style>
  .work { background: var(--bg-primary); }
  .work__item { transition: opacity 200ms ease; }
  .work__item.is-fading { opacity: 0; }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chip {
    height: 36px;
    padding: 0 16px;
    border-radius: 6px;
    background: var(--bg-secondary);
    color: var(--text-primary);
    white-space: nowrap;
    transition: background-color 200ms ease, color 200ms ease;
  }
  .chip[aria-pressed='true'] {
    background: var(--button-primary-bg);
    color: var(--button-primary-text);
  }
  /* Hover (inactive chips only): a touch darker grey. */
  .chip[aria-pressed='false']:focus-visible { background: var(--bg-tertiary); }
  @media (hover: hover) and (pointer: fine) {
    .chip[aria-pressed='false']:hover { background: var(--bg-tertiary); }
  }

  .work__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    margin: 0;
  }
  @media (min-width: 768px) {
    .work__grid { grid-template-columns: 1fr 1fr; column-gap: 24px; }
  }
  @media (min-width: 1024px) {
    .work__grid { row-gap: 40px; }
    .work__grid--3 { grid-template-columns: repeat(3, 1fr); }
  }
</style>
