---
/**
 * Hero — DESIGN_SYSTEM.md §5.3 + §6.1. Figma: Hero (State=End).
 * Intro animation (DESIGN_SYSTEM §6.1): pure CSS, starts on first paint, Home only.
 * Under prefers-reduced-motion the global rule makes everything appear in its end state.
 *
 * Layers (bottom → top): portrait (1) · arc (2) · content (3) · nav (4, in Nav.astro).
 */
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import portrait from '../../assets/brand/portrait.png';

interface Props {
  worksCount: string;
}
const { worksCount } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__portrait-clip">
    <Image
      class="hero__portrait"
      src={portrait}
      alt="Silhouette portrait of Emon Arefin"
      widths={[120, 168, 240, 336]}
      sizes="(min-width: 1024px) 168px, 120px"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="hero__arc" aria-hidden="true"></div>

  <div class="hero__content">
    <div class="hero__intro">
      <p class="hero__pill t-body">I'm Emon Arefin</p>
      <h1 id="hero-title" class="hero__title t-display">Product Designer &amp;<br />Photographer</h1>
      <p class="hero__sub t-body-lg">I design digital experiences that connect and solve problems.</p>
    </div>
    <div class="hero__ctas">
      <span class="hero__cta hero__cta--1"><Button label="See works" count={worksCount} variant="secondary" href="#work" /></span>
      <span class="hero__cta hero__cta--2"><Button label="Book a call" href="#book" /></span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 548px;
    padding-top: 104px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    overflow: hidden;
    background: var(--bg-primary);
  }

  /* 1 — Portrait, clipped so its bottom edge sits on the arc's top edge. */
  .hero__portrait-clip {
    position: relative;
    z-index: 1;
    flex: none;
    width: 120px;
    height: 120px;
    overflow: hidden;
  }
  .hero__portrait {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* 2 — Arc: full-hero layer clipped to a wide ellipse (resting state). */
  .hero__arc {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: var(--bg-secondary);
    clip-path: ellipse(750px 450px at 50% 674px); /* top edge at y = 224 */
  }

  /* 3 — Content */
  .hero__content {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 350px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    text-align: center;
  }
  .hero__intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .hero__pill {
    padding: 7px 16px;
    border-radius: 999px;
    background: var(--button-secondary-bg);
    color: var(--button-secondary-text);
    white-space: nowrap;
  }
  .hero__sub { color: var(--text-secondary); }
  .hero__ctas {
    display: flex;
    gap: 12px;
  }

  /* ── Intro timeline ─────────────────────────────────────────────── */
  .hero {
    --ease-arc: cubic-bezier(.15, .32, .1, .93);
    --ease-text: cubic-bezier(.22, 1, .36, 1);
    --portrait-from: 200px;
  }
  /* Timings come from Keystatic → Motion (fallbacks = DESIGN_SYSTEM §6.1). */
  .hero__arc {
    animation: hero-arc-mobile var(--m-hero-arc-time, 1.2s) var(--m-hero-arc-ease, var(--ease-arc)) var(--m-hero-arc-delay, 0s) both;
  }
  .hero__portrait {
    animation: hero-portrait var(--m-hero-portrait-time, 1.4s) var(--m-hero-portrait-ease, var(--ease-arc)) var(--m-hero-portrait-delay, 0.1s) both;
  }
  .hero__pill { animation: hero-text var(--m-hero-pill-time, 0.7s) var(--m-hero-pill-ease, var(--ease-text)) var(--m-hero-pill-delay, 0.45s) both; }
  .hero__title { animation: hero-text var(--m-hero-title-time, 0.7s) var(--m-hero-title-ease, var(--ease-text)) var(--m-hero-title-delay, 0.52s) both; }
  .hero__sub { animation: hero-text var(--m-hero-sub-time, 0.7s) var(--m-hero-sub-ease, var(--ease-text)) var(--m-hero-sub-delay, 0.59s) both; }
  .hero__cta--1 { animation: hero-text var(--m-hero-cta1-time, 0.7s) var(--m-hero-cta1-ease, var(--ease-text)) var(--m-hero-cta1-delay, 0.66s) both; }
  .hero__cta--2 { animation: hero-text var(--m-hero-cta2-time, 0.7s) var(--m-hero-cta2-ease, var(--ease-text)) var(--m-hero-cta2-delay, 0.73s) both; }
  .hero__cta { display: inline-flex; }

  @keyframes hero-arc-mobile {
    from { clip-path: ellipse(4000px 1500px at 50% 1480px); }
    to { clip-path: ellipse(750px 450px at 50% 674px); }
  }
  @keyframes hero-arc-desktop {
    from { clip-path: ellipse(10000px 3000px at 50% 2980px); }
    to { clip-path: ellipse(max(1500px, 104.17vw) 772px at 50% 1104px); }
  }
  @keyframes hero-portrait {
    from { transform: translateY(var(--portrait-from)); }
    to { transform: translateY(0); }
  }
  @keyframes hero-text {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (min-width: 1024px) {
    .hero { --portrait-from: 280px; }
    .hero__arc { animation-name: hero-arc-desktop; }
  }

  @media (min-width: 1024px) {
    .hero {
      height: 680px;
      padding-top: 164px;
      gap: 40px;
    }
    .hero__portrait-clip {
      width: 168px;
      height: 168px;
    }
    .hero__arc {
      /* top edge at y = 332. Horizontal radius = 1500px at 1440 (Figma) and grows with wider
         screens (104.17vw), so the curve keeps the same gentle shape instead of dropping to the bottom. */
      clip-path: ellipse(max(1500px, 104.17vw) 772px at 50% 1104px);
    }
    .hero__content { max-width: 700px; }
  }
</style>
