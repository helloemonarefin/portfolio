---
/**
 * Hero — DESIGN_SYSTEM.md §5.3 + §6.1. Figma: Hero (State=End).
 * Phase 4 = static end state. The intro animation is added in Phase 7.
 *
 * Layers (bottom → top): portrait (1) · arc (2) · content (3) · nav (4, in Nav.astro).
 */
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import portrait from '../../assets/brand/portrait.png';

interface Props {
  worksCount: string;
}
const { worksCount } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__portrait-clip">
    <Image
      class="hero__portrait"
      src={portrait}
      alt="Silhouette portrait of Emon Arefin"
      widths={[120, 168, 240, 336]}
      sizes="(min-width: 1024px) 168px, 120px"
      loading="eager"
      fetchpriority="high"
    />
  </div>

  <div class="hero__arc" aria-hidden="true"></div>

  <div class="hero__content">
    <div class="hero__intro">
      <p class="hero__pill t-body">I'm Emon Arefin</p>
      <h1 id="hero-title" class="hero__title t-display">Product Designer &amp;<br />Photographer</h1>
      <p class="hero__sub t-body-lg">I design digital experiences that connect and solve problems.</p>
    </div>
    <div class="hero__ctas">
      <Button label="View Projects" count={worksCount} variant="secondary" href="#work" />
      <Button label="Hire Me" href="#book" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 548px;
    padding-top: 104px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    overflow: hidden;
    background: var(--bg-primary);
  }

  /* 1 — Portrait, clipped so its bottom edge sits on the arc's top edge. */
  .hero__portrait-clip {
    position: relative;
    z-index: 1;
    flex: none;
    width: 120px;
    height: 120px;
    overflow: hidden;
  }
  .hero__portrait {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* 2 — Arc: full-hero layer clipped to a wide ellipse (resting state). */
  .hero__arc {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: var(--bg-secondary);
    clip-path: ellipse(750px 450px at 50% 674px); /* top edge at y = 224 */
  }

  /* 3 — Content */
  .hero__content {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 350px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    text-align: center;
  }
  .hero__intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .hero__pill {
    padding: 7px 16px;
    border-radius: 999px;
    background: var(--button-secondary-bg);
    color: var(--button-secondary-text);
    white-space: nowrap;
  }
  .hero__sub { color: var(--text-secondary); }
  .hero__ctas {
    display: flex;
    gap: 12px;
  }

  @media (min-width: 1024px) {
    .hero {
      height: 680px;
      padding-top: 164px;
      gap: 40px;
    }
    .hero__portrait-clip {
      width: 168px;
      height: 168px;
    }
    .hero__arc {
      clip-path: ellipse(1500px 772px at 50% 1104px); /* top edge at y = 332 */
    }
    .hero__content { max-width: 700px; }
  }
</style>
