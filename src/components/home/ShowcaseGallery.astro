---
/**
 * Showcase Gallery — DESIGN_SYSTEM.md §5.4 / BUILD_PROMPT.md §6.5. Figma: Showcase Gallery.
 * Two Embla carousels (top + bottom rows). Both rows behave the same: infinite loop, autoplay one item
 * every 5s, drag/swipe, pause only while dragged. The bottom row's cards are half a top slide wide, so two
 * bottom cards line up under each top slide (3 columns on top, 6 below — Emon, 2026-11-10).
 * Arrows move both rows; dots follow the top row. Images, GIFs or videos from Keystatic → Showcase gallery.
 */
import Media from '../ui/Media.astro';
import Icon from '../ui/Icon.astro';
import type { ShowcaseItem } from '../../lib/content';

interface Props {
  featured: ShowcaseItem[];
  more: ShowcaseItem[];
}
const { featured, more } = Astro.props;

/** Repeat a list until it has at least `min` items, so the loop always looks full. */
const fill = <T,>(items: T[], min = 5): T[] => {
  if (items.length === 0) return [];
  const out = [...items];
  while (out.length < min) out.push(...items);
  return out;
};
const featuredSlides = fill(featured);
// Narrow cards: repeat to at least 12 so the loop always has more cards than fit on screen
// (Embla quietly turns looping off when there aren't enough).
const moreSlides = fill(more, 12);
---

{
  featuredSlides.length > 0 && (
    <section
      class="showcase"
      aria-roledescription="carousel"
      aria-label="Showcase"
      data-showcase
      data-unique={featured.length}
    >
      <div class="showcase__row showcase__row--featured" data-reveal-group data-video-group>
        <div class="showcase__viewport" data-featured>
          <div class="showcase__track">
            {featuredSlides.map((p, i) => (
              <div class="showcase__slide" role="group" aria-roledescription="slide" data-reveal>
                <Media
                  media={p.data.media}
                  widths={[330, 660, 940, 1880]}
                  sizes="(min-width: 1024px) 940px, 330px"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                />
              </div>
            ))}
          </div>
        </div>
        <button class="showcase__arrow showcase__arrow--prev" type="button" aria-label="Previous" data-prev>
          <Icon name="arrow-left" />
        </button>
        <button class="showcase__arrow showcase__arrow--next" type="button" aria-label="Next" data-next>
          <Icon name="arrow-right" />
        </button>
      </div>

      {moreSlides.length > 0 && (
        <div class="showcase__row showcase__row--more" data-reveal-group data-video-group>
          <div class="showcase__viewport" data-more>
            <div class="showcase__track">
              {moreSlides.map((p) => (
                <div class="showcase__card" data-reveal>
                  <Media media={p.data.media} widths={[161, 322, 463, 926]} sizes="(min-width: 1024px) 463px, 161px" />
                </div>
              ))}
            </div>
          </div>
        </div>
      )}

      {featured.length > 1 && (
        <div class="showcase__pagination">
          <div class="showcase__dots">
            {featured.map((_, i) => (
              <button
                class="showcase__dot"
                type="button"
                aria-label={`Go to slide ${i + 1}`}
                aria-current={i === 0 ? 'true' : undefined}
                data-dot={i}
              />
            ))}
          </div>
        </div>
      )}
    </section>
  )
}

<script>
  import EmblaCarousel, { type EmblaCarouselType } from 'embla-carousel';
  import Autoplay from 'embla-carousel-autoplay';

  const HOLD = 4000; // 4s hold + ~1s slide ≈ one item every 5s

  for (const root of document.querySelectorAll<HTMLElement>('[data-showcase]')) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const unique = Number(root.dataset.unique) || 1;
    const featuredEl = root.querySelector<HTMLElement>('[data-featured]')!;
    const moreEl = root.querySelector<HTMLElement>('[data-more]');

    root.classList.add('is-ready');

    const autoplayOptions = {
      delay: HOLD,
      playOnInit: !reduceMotion,
      stopOnInteraction: false,
      stopOnMouseEnter: false,
      stopOnFocusIn: false,
    };
    const autoplayTop = Autoplay(autoplayOptions);
    const autoplayBottom = Autoplay(autoplayOptions);

    const featured = EmblaCarousel(
      featuredEl,
      { loop: true, align: 'center', duration: 38, skipSnaps: false },
      [autoplayTop],
    );

    // Bottom row: same behaviour as the top row. Its cards are aligned so that two of them sit
    // exactly under one top slide (left edge of a card = left edge of the centred top slide).
    const bottomAlign = (viewSize: number) => {
      const card = moreEl?.querySelector<HTMLElement>('.showcase__card');
      if (!card) return 0;
      const w = card.getBoundingClientRect().width;
      const gap = parseFloat(getComputedStyle(card).marginRight) || 0;
      return viewSize / 2 - w - gap / 2;
    };
    const more = moreEl
      ? EmblaCarousel(moreEl, { loop: true, align: bottomAlign, duration: 38, skipSnaps: false }, [autoplayBottom])
      : null;

    const rows: [EmblaCarouselType | null, ReturnType<typeof Autoplay>, HTMLElement | null][] = [
      [featured, autoplayTop, featuredEl],
      [more, autoplayBottom, moreEl],
    ];

    // ── Dots (top row) ──
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const updateDots = () => {
      const active = featured.selectedScrollSnap() % unique;
      dots.forEach((d, i) => (i === active ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
    };
    featured.on('select', updateDots);
    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => {
        // jump to the nearest copy of slide i
        const n = featured.scrollSnapList().length;
        const cur = featured.selectedScrollSnap();
        let best = i;
        for (let k = i; k < n; k += unique) if (Math.abs(k - cur) < Math.abs(best - cur)) best = k;
        featured.scrollTo(best);
        interacted();
      }),
    );

    // ── Arrows move both rows one step ──
    root.querySelector('[data-prev]')?.addEventListener('click', () => { featured.scrollPrev(); more?.scrollPrev(); interacted(); });
    root.querySelector('[data-next]')?.addEventListener('click', () => { featured.scrollNext(); more?.scrollNext(); interacted(); });

    // ── Autoplay keeps running while hovered or scrolled (Emon, 2026-11-10).
    //    A row pauses only while it is being dragged and restarts as soon as it's let go.
    //    Arrow / dot clicks restart the 4s hold. Both pause while the browser tab is hidden. ──
    const canPlay = () => !reduceMotion && !document.hidden;
    function interacted() { if (!reduceMotion) { autoplayTop.reset(); autoplayBottom.reset(); } }

    // Native pointer events (reliable for mouse, touch and pen).
    for (const [api, autoplay, viewport] of rows) {
      if (!api || !viewport) continue;
      viewport.addEventListener('pointerdown', (e) => {
        if (e.button !== 0) return;
        autoplay.stop();
        viewport.classList.add('is-dragging');
        const end = () => {
          viewport.classList.remove('is-dragging');
          if (canPlay()) autoplay.play();
          window.removeEventListener('pointerup', end);
          window.removeEventListener('pointercancel', end);
        };
        window.addEventListener('pointerup', end);
        window.addEventListener('pointercancel', end);
      });
    }
    document.addEventListener('visibilitychange', () => {
      for (const [, autoplay] of rows) document.hidden ? autoplay.stop() : canPlay() && autoplay.play();
    });
  }
</script>

<style>
  .showcase {
    background: var(--bg-primary);
    padding: 8px 0 72px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 8px;
    --slide-w: 330px;
    --gap: 8px;
  }
  @media (min-width: 1024px) {
    .showcase {
      padding: 12px 0 128px;
      gap: 14px;
      --slide-w: 940px;
      --gap: 14px;
    }
  }

  .showcase__row { position: relative; }
  .showcase__viewport { overflow: hidden; }
  /* Drag cursor: open hand on hover, closed hand while dragging. */
  .showcase__viewport { cursor: grab; }
  .showcase__viewport.is-dragging,
  .showcase__viewport:active { cursor: grabbing; }
  .showcase__track {
    display: flex;
    touch-action: pan-y pinch-zoom;
  }

  /* Each slide carries its own gap as right margin (Embla measures margins). */
  .showcase__slide,
  .showcase__card {
    flex: none;
    margin-right: var(--gap);
  }
  /* Featured: fixed width, height follows the thumbnail's own shape (no cropping). */
  .showcase__slide { width: var(--slide-w); }
  /* Bottom row card = half a top slide (two cards under each slide): 6 columns where the top has 3. */
  .showcase { --card-w: calc((var(--slide-w) - var(--gap)) / 2); }
  /* Bottom row: fixed width, height follows each image / video (no cropping). */
  .showcase__card { width: var(--card-w); }

  /* Before the script runs: both rows start under the centred top slide (no jump on load). */
  .showcase:not(.is-ready) .showcase__track {
    margin-left: calc(50% - var(--slide-w) / 2);
  }

  .showcase__track { align-items: flex-start; }
  .showcase__slide :global(img),
  .showcase__slide :global(video),
  .showcase__card :global(img),
  .showcase__card :global(video) {
    display: block;
    width: 100%;
    height: auto;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* Arrows */
  .showcase__arrow {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: var(--surface-overlay);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    color: var(--text-primary);
    transition: scale 200ms ease;
  }
  .showcase__arrow--prev { left: 8px; }
  .showcase__arrow--next { right: 8px; }
  @media (min-width: 1024px) {
    .showcase__arrow { width: 40px; height: 40px; }
    /* 24px outside the featured slide; never closer than 8px to the screen edge. */
    .showcase__arrow--prev { left: max(8px, calc(50% - 548px)); }
    .showcase__arrow--next { right: max(8px, calc(50% - 548px)); }
  }
  .showcase__arrow:focus-visible { scale: 1.05; }
  @media (hover: hover) and (pointer: fine) {
    .showcase__arrow:hover { scale: 1.05; }
  }

  /* Pagination */
  .showcase__pagination {
    display: flex;
    justify-content: center;
    padding-top: 8px; /* + row gap 8 = 16 */
  }
  @media (min-width: 1024px) {
    .showcase__pagination { padding-top: 4px; } /* + row gap 14 = 18 */
  }
  /* Dots: 8px, 20px apart centre to centre (12px gap); the selected one stretches to a 20px pill
     (Emon, 2026-11-10). */
  .showcase__dots {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 28px;
    padding: 0 14px;
    border-radius: 999px;
    background: var(--bg-tertiary);
  }
  @media (min-width: 1024px) {
    .showcase__dots { height: 32px; padding: 0 16px; }
  }
  .showcase__dot {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--text-tertiary);
    opacity: 0.6;
    transition: width 300ms cubic-bezier(0.22, 1, 0.36, 1), background-color 200ms ease, opacity 200ms ease;
  }
  /* Bigger invisible hit area around each dot (fills the gaps, no overlap). */
  .showcase__dot::after { content: ""; position: absolute; inset: -8px -6px; }
  .showcase__dot[aria-current='true'] {
    width: 20px;
    background: var(--text-primary);
    opacity: 1;
  }
</style>
