---
/**
 * About Intro — DESIGN_SYSTEM.md §5.12 / BUILD_PROMPT.md §6.11. Figma: About Intro.
 * Two columns on desktop; stacked on mobile (photo below the text).
 * The photo is a labelled placeholder until src/assets/brand/about-photo.jpg is supplied.
 */
import Icon from '../ui/Icon.astro';

interface Props {
  bio: string[];
  years: string;
  projects: string;
}
const { bio, years, projects } = Astro.props;

const facts = [
  { value: years, label: 'Years designing' },
  { value: projects, label: 'Projects shipped' },
  { value: 'GMT+6', label: 'Bangladesh' },
].filter((f) => f.value);
---

<section class="intro" aria-labelledby="about-title">
  <div class="container intro__inner">
    <div class="intro__text">
      <p class="intro__eyebrow t-body">About me</p>
      <h1 id="about-title" class="intro__title t-display">
        Hi, I’m Emon — a product designer and photographer from Bangladesh.
      </h1>
      {
        bio.length > 0 && (
          <div class="intro__bio t-body-lg">
            {bio.map((p) => <p>{p}</p>)}
          </div>
        )
      }
      <dl class="intro__facts">
        {
          facts.map((f) => (
            <div class="intro__fact">
              <dt class="t-caption">{f.label}</dt>
              <dd class="t-h3">{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="intro__photo" role="img" aria-label="Photo of Emon (placeholder)">
      <Icon name="image" />
      <span class="t-caption">Your photo · 4:5</span>
    </div>
  </div>
</section>

<style>
  .intro {
    background: var(--bg-primary);
    padding: 48px 0 72px;
  }
  .intro__inner {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .intro__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }
  .intro__eyebrow {
    padding: 7px 16px;
    border-radius: 999px;
    background: var(--bg-secondary);
    color: var(--text-primary);
  }
  .intro__bio {
    display: flex;
    flex-direction: column;
    gap: 16px;
    color: var(--text-secondary);
  }

  /* Facts: value (h3) above label (caption) */
  .intro__facts {
    display: flex;
    justify-content: space-between;
    width: 100%;
    padding-top: 8px;
    margin: 0;
  }
  .intro__fact {
    display: flex;
    flex-direction: column-reverse; /* dt is first in the markup for screen readers */
    gap: 4px;
  }
  .intro__fact dt { color: var(--text-secondary); }
  .intro__fact dd { margin: 0; white-space: nowrap; }

  .intro__photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: var(--bg-tertiary);
    color: var(--text-tertiary);
  }

  @media (min-width: 1024px) {
    .intro { padding: 96px 0 128px; }
    .intro__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 56px;
    }
    .intro__text { gap: 24px; max-width: 600px; }
    .intro__bio { max-width: 560px; }
    .intro__facts { width: auto; justify-content: flex-start; gap: 40px; }
    .intro__photo { flex: none; width: 560px; }
  }
</style>
