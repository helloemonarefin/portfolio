---
/**
 * Nav — DESIGN_SYSTEM.md §5.2 / BUILD_PROMPT.md §6.3. Figma: Nav (Desktop / Mobile).
 * Sticky (decided 2026-11-08): stays pinned to the top while scrolling. Once the page scrolls,
 * it gets --surface-overlay + 12px backdrop blur. `overlay` = on Home it starts transparent
 * over the hero (it overlaps the hero instead of pushing it down).
 * Mobile menu — Figma "Mobile Nav Dropdown" (251:2232): links 16px medium (gap 20, padding 20), the same
 * "Book a call" button as desktop 28px below; at the bottom four equal bordered social boxes
 * (Keystatic → Settings → Socials) and the copyright line. Fades in + moves 8px down over 250ms; icon morphs to ×.
 */
import Logo from '../ui/Logo.astro';
import Button from '../ui/Button.astro';
import RollText from '../ui/RollText.astro';
import Icon from '../ui/Icon.astro';
import { getSettings } from '../../lib/content';

interface Props {
  worksCount: string;
  overlay?: boolean;
}
const { worksCount, overlay = false } = Astro.props;

const links = [
  { label: 'Home', href: '/' },
  { label: 'Works', href: '/#work', count: worksCount },
  { label: 'About', href: '/about' },
  { label: 'Pricing', href: '/#pricing' },
  { label: 'Contact', href: '/#book' },
];
const { socials } = await getSettings();
const socialLinks = [
  { label: 'LinkedIn', href: socials.linkedin },
  { label: 'X / Twitter', href: socials.x },
  { label: 'Dribbble', href: socials.dribbble },
  { label: 'Behance', href: socials.behance },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class:list={['nav', { 'nav--overlay': overlay, 'nav--intro': overlay }]} data-nav>
  <div class="nav__row">
    <span class="nav__brand"><Logo href="/" /></span>

    <nav class="nav__links" aria-label="Main">
      <ul role="list">
        {
          links.map((l, i) => (
            <li class="nav__item" style={`--i:${i + 1}`}>
              <a class="nav__link t-label roll-trigger" href={l.href} aria-current={l.href === path ? 'page' : undefined}>
                <RollText text={l.label} />
                {l.count && <span class="nav__count">{l.count}</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav__actions">
      <Button label="Book a call" size="sm" href="/#book" />
    </div>

    <button
      class="nav__menu"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span class="nav__menu-icon" aria-hidden="true"><span></span><span></span></span>
    </button>
  </div>

  <div class="nav__panel" id="mobile-menu" data-menu-panel data-lenis-prevent inert>
    <nav aria-label="Mobile">
      <ul class="nav__panel-links" role="list">
        {
          links.map((l) => (
            <li>
              <a class="nav__panel-link" href={l.href} aria-current={l.href === path ? 'page' : undefined}>
                {l.label}
                {l.count && <span class="nav__count">{l.count}</span>}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="nav__panel-cta">
        <Button label="Book a call" layout="fill" href="/#book" />
      </div>
    </nav>
    <div class="nav__panel-foot">
      <ul class="nav__socials" role="list" aria-label="Social links">
        {
          socialLinks.map((l) => (
            <li class="nav__social-item">
              {l.href ? (
                <a class="nav__social t-label" href={l.href} target="_blank" rel="noopener noreferrer">
                  <span>{l.label}</span><Icon name="arrow-up-right-sm" /><span class="sr-only"> (opens in a new tab)</span>
                </a>
              ) : (
                <span class="nav__social t-label">
                  <span>{l.label}</span><Icon name="arrow-up-right-sm" />
                </span>
              )}
            </li>
          ))
        }
      </ul>
      <p class="nav__copyright t-caption">© 2026 Emon Arefin. All rights reserved.</p>
    </div>
  </div>
</header>

<script>
  import { lockScroll } from '../../scripts/scroll';

  for (const nav of document.querySelectorAll<HTMLElement>('[data-nav]')) {
    // Frosted background once the page has scrolled.
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        nav.classList.toggle('is-scrolled', window.scrollY > 4);
        ticking = false;
      });
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    const toggle = nav.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
    const panel = nav.querySelector<HTMLElement>('[data-menu-panel]')!;
    const desktop = window.matchMedia('(min-width: 1024px)');

    const focusables = () =>
      [...nav.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')].filter(
        (el) => el.offsetParent !== null && !el.closest('[inert]'),
      );

    const setOpen = (open: boolean, returnFocus = true) => {
      nav.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      panel.inert = !open;
      lockScroll(open);
      if (open) panel.querySelector<HTMLElement>('a')?.focus();
      else if (returnFocus) toggle.focus();
    };

    toggle.addEventListener('click', () => setOpen(!nav.classList.contains('is-open')));
    panel.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false, false)));

    nav.addEventListener('keydown', (e) => {
      if (!nav.classList.contains('is-open')) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        setOpen(false);
      } else if (e.key === 'Tab') {
        // keep focus inside the nav + menu while open
        const items = focusables();
        const first = items[0];
        const last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last?.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first?.focus(); }
      }
    });

    // Close if the window grows to desktop size.
    desktop.addEventListener('change', (e) => e.matches && nav.classList.contains('is-open') && setOpen(false, false));
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 4;
    height: 64px;
    padding: 14px 20px;
    border-bottom: var(--border-width, 1px) solid var(--border-primary);
    background: var(--bg-primary);
    transition: background-color 200ms ease;
  }
  /* Home: overlaps the hero (pulls the hero up under it) and starts transparent. */
  .nav--overlay {
    margin-bottom: -64px;
    background: transparent;
  }
  .nav.is-scrolled {
    background: var(--surface-overlay);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  .nav.is-open { background: var(--bg-primary); }

  /* Home intro: logo first, then each link 0.05s apart, then "Book a call" 0.1s after the last link.
     Timings come from Keystatic → Motion → Nav intro. */
  .nav__brand,
  .nav__item,
  .nav__actions,
  .nav__menu { --nav-delay: var(--m-nav-delay, 0.1s); }
  .nav__item { --nav-delay: calc(var(--m-nav-delay, 0.1s) + var(--i) * var(--m-nav-stagger, 0.05s)); }
  .nav__actions,
  .nav__menu {
    --nav-delay: calc(var(--m-nav-delay, 0.1s) + 5 * var(--m-nav-stagger, 0.05s) + var(--m-nav-button-gap, 0.1s));
  }
  .nav--intro :is(.nav__brand, .nav__item, .nav__actions, .nav__menu) {
    animation: nav-in var(--m-nav-time, 1s) var(--m-nav-ease, cubic-bezier(0, .77, .56, 1)) var(--nav-delay) both;
  }
  .nav__brand { display: inline-flex; }
  @keyframes nav-in {
    from { opacity: 0.001; translate: 0 calc(var(--m-nav-distance, 150px) * -1); }
    to { opacity: 1; translate: 0 0; }
  }
  .nav__row {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav__links,
  .nav__actions { display: none; }

  /* ── Menu button: two lines that morph into × ── */
  .nav__menu {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 6px;
    background: var(--bg-secondary);
    color: var(--text-primary);
  }
  .nav__menu-icon {
    position: relative;
    width: 12px;
    height: 6.5px;
  }
  .nav__menu-icon span {
    position: absolute;
    left: 0;
    width: 12px;
    height: 1.5px;
    border-radius: 1px;
    background: currentColor;
    transition: transform 250ms cubic-bezier(.22, 1, .36, 1), top 250ms cubic-bezier(.22, 1, .36, 1);
  }
  .nav__menu-icon span:first-child { top: 0; }
  .nav__menu-icon span:last-child { top: 5px; }
  .is-open .nav__menu-icon span:first-child { top: 2.5px; transform: rotate(45deg); }
  .is-open .nav__menu-icon span:last-child { top: 2.5px; transform: rotate(-45deg); }

  /* ── Mobile menu panel ── */
  .nav__panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: calc(100dvh - 64px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 20px calc(20px + env(safe-area-inset-bottom));
    background: var(--bg-primary);
    opacity: 0;
    visibility: hidden;
    translate: 0 -8px;
    transition: opacity 250ms ease, translate 250ms cubic-bezier(.22, 1, .36, 1), visibility 0s linear 250ms;
  }
  .is-open .nav__panel {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
    transition: opacity 250ms ease, translate 250ms cubic-bezier(.22, 1, .36, 1), visibility 0s;
  }
  .nav__panel-links {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin: 0;
  }
  .nav__panel-link {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    color: var(--text-primary);
    text-decoration: none;
  }
  .nav__panel-link .nav__count { font-size: var(--font-size-label); }
  .nav__panel-cta { margin-top: 28px; } /* links → button */
  .nav__panel-link {
    font-size: var(--font-size-body-lg); /* 16 on mobile */
    line-height: 22px;
    font-weight: 500;
    letter-spacing: -0.0225em;
  }
  .nav__panel-foot { display: flex; flex-direction: column; gap: 20px; padding-top: 20px; }
  /* Four equal boxes sharing 1px borders (the list draws top + left, each box right + bottom).
     Phones narrower than 390px: 2 × 2, so "X / Twitter" still fits. */
  .nav__socials {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--border-width, 1px) solid var(--border-primary);
    border-left: var(--border-width, 1px) solid var(--border-primary);
  }
  @media (max-width: 389px) {
    .nav__socials { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .nav__social {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    height: 46px;
    padding: 0 6px;
    border-right: var(--border-width, 1px) solid var(--border-primary);
    border-bottom: var(--border-width, 1px) solid var(--border-primary);
    color: var(--text-secondary);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 200ms ease, color 200ms ease;
  }
  .nav__social :global(svg) { flex: none; }
  a.nav__social:focus-visible { background: var(--bg-secondary); color: var(--text-primary); outline-offset: -2px; }
  @media (hover: hover) and (pointer: fine) {
    a.nav__social:hover { background: var(--bg-secondary); color: var(--text-primary); }
  }
  .nav__copyright { color: var(--text-secondary); }

  @media (min-width: 1024px) {
    .nav {
      height: 85px;
      padding: 24px 48px;
    }
    .nav--overlay { margin-bottom: -85px; }
    .nav__row {
      display: grid;
      grid-template-columns: 1fr auto 1fr; /* links stay centred */
      align-items: center;
    }
    .nav__menu,
    .nav__panel { display: none; }
    .nav__links,
    .nav__actions { display: flex; }
    .nav__actions { justify-content: flex-end; }

    .nav__links ul {
      display: flex;
      gap: 12px;
      margin: 0;
    }
    .nav__link {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      height: 32px;
      padding: 5px 10px;
      border-radius: 4px;
      color: var(--text-secondary);
      text-decoration: none;
      white-space: nowrap;
      transition: color 150ms ease;
    }
    .nav__link:focus-visible { color: var(--text-primary); }
  }
  .nav__count { color: var(--text-tertiary); }

  @media (min-width: 1024px) and (hover: hover) and (pointer: fine) {
    .nav__link:hover { color: var(--text-primary); }
  }
</style>
