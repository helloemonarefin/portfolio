---
/**
 * Footer — DESIGN_SYSTEM.md §5.11 / BUILD_PROMPT.md §6.10. Figma: Footer (Desktop / Mobile).
 */
import { Image } from 'astro:assets';
import Logo from '../ui/Logo.astro';
import Icon from '../ui/Icon.astro';
import RollText from '../ui/RollText.astro';
import { getSettings } from '../../lib/content';
import dottedDesktop from '../../assets/brand/dotted-logo-desktop.svg?url';
import dottedMobile from '../../assets/brand/dotted-logo-mobile.svg?url';

const settings = await getSettings();

// "Get an AI summary" buttons — Keystatic → Settings → AI summary buttons (icon + link each).
// Items without a link are skipped; items without an icon show a dashed placeholder.
const assistants = settings.aiSummary.filter((a) => a.url);

const navigate = [
  { label: 'Home', href: '/' },
  { label: 'Work', href: '/#work' },
  { label: 'About', href: '/about' },
  { label: 'Pricing', href: '/#pricing' },
  { label: 'Book a call', href: '/#book' },
];
// No destinations are specified for these yet, so they render as plain text.
const services = ['Website design', 'Framer development', 'Monthly subscription', 'Framer templates'];
const { socials } = settings;
const connect = [
  { label: 'LinkedIn', href: socials.linkedin },
  { label: 'X / Twitter', href: socials.x },
  { label: 'Dribbble', href: socials.dribbble },
  { label: 'Behance', href: socials.behance },
  { label: 'Resume', href: socials.resumeUrl },
];
---

<footer class="footer">
  <div class="container footer__content">
    <div class="footer__brand">
      <div class="footer__identity">
        <span data-reveal><Logo href="/" /></span>
        <p class="footer__blurb t-body-sm" data-reveal>
          Framer designer and developer crafting fast, considered websites for startups, studios and creators.
        </p>
        <p class="footer__location t-caption" data-reveal>Based in Bangladesh · GMT+6</p>
      </div>

      <div class="footer__ai">
        <p class="t-caption t-medium" data-reveal>Get an AI summary of Emon</p>
        <ul class="footer__ai-list" role="list">
          {
            assistants.map((a) => (
              <li data-reveal>
                <a
                  class="footer__ai-btn"
                  href={a.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Ask ${a.name} for a summary of Emon (opens in a new tab)`}
                  title={a.name}
                >
                  {a.icon ? (
                    <Image class="footer__ai-icon" src={a.icon} alt="" width={40} height={40} />
                  ) : (
                    <span class="footer__ai-placeholder" aria-hidden="true" />
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <nav class="footer__columns" aria-label="Footer">
      <div class="footer__col">
        <h2 class="t-caption t-medium" data-reveal>Navigate</h2>
        <ul role="list">
          {navigate.map((l) => <li data-reveal><a class="footer__link t-label roll-trigger" href={l.href}><RollText text={l.label} /></a></li>)}
        </ul>
      </div>
      <div class="footer__col">
        <h2 class="t-caption t-medium" data-reveal>Services</h2>
        <ul role="list">
          {services.map((s) => <li data-reveal><span class="footer__link footer__link--static t-label roll-trigger"><RollText text={s} /></span></li>)}
        </ul>
      </div>
      <div class="footer__col">
        <h2 class="t-caption t-medium" data-reveal>Social</h2>
        <ul role="list">
          {
            connect.map((c) => (
              <li data-reveal>
                {c.href ? (
                  <a class="footer__link t-label roll-trigger" href={c.href} target="_blank" rel="noopener noreferrer">
                    <RollText text={c.label} /><Icon name="arrow-up-right-sm" /><span class="sr-only"> (opens in a new tab)</span>
                  </a>
                ) : (
                  <span class="footer__link footer__link--static t-label roll-trigger"><RollText text={c.label} /><Icon name="arrow-up-right-sm" /></span>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </nav>
  </div>

  <div class="container footer__dotted" aria-hidden="true" data-reveal>
    <picture>
      <source media="(min-width: 1024px)" srcset={dottedDesktop} width="1376" height="272" />
      <img src={dottedMobile} width="350" height="70" alt="" loading="lazy" decoding="async" />
    </picture>
  </div>

  <div class="container footer__bottom">
    <p class="t-caption" data-reveal>© 2026 Emon Arefin. All rights reserved.</p>
    <ul class="footer__legal" role="list">
      <li data-reveal><span class="footer__link footer__link--static t-label roll-trigger"><RollText text="Privacy" /></span></li>
      <li data-reveal><span class="footer__link footer__link--static t-label roll-trigger"><RollText text="Terms" /></span></li>
      <li data-reveal><a class="footer__link t-label roll-trigger" href="#top"><RollText text="Back to top" /> ↑</a></li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    border-top: var(--border-width, 1px) solid var(--border-primary);
    padding-top: 64px;
    background: var(--bg-primary);
  }
  @media (min-width: 1024px) {
    .footer { padding-top: 96px; }
  }

  .footer__content {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-bottom: 48px;
  }
  @media (min-width: 1024px) {
    .footer__content {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }
  }

  .footer__brand { display: flex; flex-direction: column; gap: 40px; }
  .footer__identity { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .footer__blurb { max-width: 400px; color: var(--text-secondary); }
  .footer__location { color: var(--text-tertiary); }

  .footer__ai { display: flex; flex-direction: column; gap: 12px; }
  .footer__ai-list { display: flex; gap: 8px; margin: 0; }
  .footer__ai-btn {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 0; /* sharp edges (2026-11-09) */
    background: var(--bg-secondary);
    transition: background-color 200ms ease;
  }
  .footer__ai-icon { width: 20px; height: 20px; object-fit: contain; }
  .footer__ai-placeholder {
    width: 18px;
    height: 18px;
    border: var(--border-width, 1px) dashed var(--text-tertiary);
    border-radius: 0;
  }

  .footer__columns {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
  }
  @media (min-width: 1024px) {
    .footer__columns { flex-wrap: nowrap; gap: 112px; }
  }
  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 155px;
  }
  @media (min-width: 1024px) {
    .footer__col { width: auto; }
  }
  .footer__col ul { display: flex; flex-direction: column; gap: 16px; margin: 0; }
  /* flex items: no extra line-height strut, so the gap is exactly 16 */
  .footer__col li,
  .footer__legal li { display: flex; }
  .footer__link {
    color: var(--text-secondary);
    text-decoration: none;
    white-space: nowrap;
    transition: color 150ms ease;
  }
  a.footer__link:focus-visible { color: var(--text-primary); }
  /* Social column: label + 16px ↗ icon, 4px apart (same as the mobile menu). */
  .footer__link:has(> :global(svg)) { display: inline-flex; align-items: center; gap: 4px; }
  .footer__link > :global(svg) { flex: none; }

  .footer__dotted img {
    width: 100%;
    height: auto;
  }

  /* Credit row: clear gap below the dotted logo, a hairline on top (inside the side padding), then padding. */
  .footer__bottom {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 40px;
    padding-top: 24px;
    padding-bottom: 28px;
    color: var(--text-secondary);
  }
  .footer__bottom::before {
    content: "";
    position: absolute;
    top: 0;
    left: 20px;
    right: 20px;
    height: var(--border-width, 1px);
    background: var(--border-primary);
  }
  @media (min-width: 1024px) {
    .footer__bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      margin-top: 64px;
    }
    .footer__bottom::before { left: 32px; right: 32px; }
  }
  .footer__legal { display: flex; gap: 24px; margin: 0; }

  @media (hover: hover) and (pointer: fine) {
    a.footer__link:hover { color: var(--text-primary); }
    .footer__ai-btn:hover { background: var(--bg-tertiary); }
  }
  .footer__ai-btn:focus-visible { background: var(--bg-tertiary); }
</style>
