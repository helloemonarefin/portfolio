---
/**
 * Button — "Chip Sweep". DESIGN_SYSTEM.md §5.1, BUILD_PROMPT.md §6.1.
 * Figma component: Button (Style × Size × State × Layout).
 *
 * variant  primary | secondary | secondary-chip
 * size     md (40px) | sm (36px)
 * layout   hug | fill (fill = full width, label centred)
 * href     renders <a>; otherwise <button>
 * count    small grey number after the label, e.g. "08" (secondary variants)
 */
import Icon from './Icon.astro';

interface Props {
  label: string;
  variant?: 'primary' | 'secondary' | 'secondary-chip';
  size?: 'md' | 'sm';
  layout?: 'hug' | 'fill';
  count?: string;
  href?: string;
  external?: boolean;
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}

const {
  label,
  variant = 'primary',
  size = 'md',
  layout = 'hug',
  count,
  href,
  external = false,
  type = 'button',
  class: className,
  ...rest
} = Astro.props;

const hasChip = variant === 'primary' || variant === 'secondary-chip';
const classes = ['btn', `btn--${variant}`, `btn--${size}`, `btn--${layout}`, className];
const Tag = href ? 'a' : 'button';
const tagProps = href
  ? { href, ...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {}) }
  : { type };
---

<Tag class:list={classes} {...tagProps} {...rest}>
  {
    hasChip && (
      <span class="btn__chip" aria-hidden="true">
        <Icon name="chevron-right" />
      </span>
    )
  }
  <span class="btn__label">{label}</span>
  {count && <span class="btn__count">{count}</span>}
</Tag>

<style>
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 40px;
    border-radius: 6px;
    font-family: var(--font-sans);
    font-size: var(--font-size-label);
    line-height: var(--line-height-label);
    font-weight: 500;
    letter-spacing: -0.01em;
    white-space: nowrap;
    text-decoration: none;
    overflow: hidden;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .btn--sm { height: 36px; }
  .btn--fill { width: 100%; }

  .btn__label,
  .btn__count {
    position: relative;
    z-index: 1;
    transition: translate var(--m-button-time, 450ms) var(--m-button-ease, cubic-bezier(.22, 1, .36, 1));
  }
  .btn__count {
    font-weight: 400;
    color: var(--text-tertiary);
  }

  /* ---------- The chip (primary + secondary-chip) ---------- */
  /* Rule: the chip keeps exactly 4px to every button edge it touches. */
  .btn__chip {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 4px;
    width: 32px;
    border-radius: 3px;
    display: flex;
    align-items: center;
    justify-content: flex-end; /* the chevron rides on the chip's right edge */
    padding-inline: 8px;
    transition: width var(--m-button-time, 450ms) var(--m-button-ease, cubic-bezier(.22, 1, .36, 1));
  }
  .btn__chip :global(svg) { flex: none; }
  .btn--sm .btn__chip {
    width: 28px;
    padding-inline: 6px;
  }

  /* ---------- Primary ---------- */
  .btn--primary {
    background: var(--button-primary-bg);
    color: var(--button-primary-text);
    border: 0;
    padding: 0 16px 0 44px; /* hug: small right padding — the label slides left on hover */
    transition: background-color var(--m-button-time, 450ms) var(--m-button-ease, cubic-bezier(.22, 1, .36, 1));
  }
  .btn--primary.btn--sm { padding: 0 14px 0 40px; }
  .btn--primary.btn--fill { padding-inline: 44px; }
  .btn--primary .btn__chip {
    background: var(--button-primary-chip);
    /* Primary: the square chip travels from the left edge to the right edge (Figma 2026-11-09). */
    transition: left var(--m-button-time, 450ms) var(--m-button-ease, cubic-bezier(.22, 1, .36, 1));
  }

  /* ---------- Secondary-chip ---------- */
  /* Same geometry as primary. It has a 1px border, so offsets inside the border
     are 1px smaller — the chip still sits 4px from the outer edge. */
  .btn--secondary-chip {
    background: var(--button-secondary-bg);
    color: var(--button-secondary-text);
    border: var(--border-width, 1px) solid var(--button-secondary-border);
    padding: 0 15px 0 43px;
  }
  .btn--secondary-chip.btn--sm { padding: 0 13px 0 39px; }
  .btn--secondary-chip.btn--fill { padding-inline: 43px; }
  .btn--secondary-chip .btn__chip {
    top: 3px;
    bottom: 3px;
    left: 3px;
    background: var(--bg-secondary);
    color: var(--text-primary);
  }

  /* ---------- Secondary (plain) ---------- */
  .btn--secondary {
    gap: 6px;
    background: var(--button-secondary-bg);
    color: var(--button-secondary-text);
    border: var(--border-width-thin, 0.5px) solid var(--button-secondary-border); /* Figma: 0.5px (decided 2026-11-08) */
    padding: 0 14px;
    transition:
      background-color var(--m-button-time, 450ms) var(--m-button-ease, cubic-bezier(.22, 1, .36, 1)),
      border-color var(--m-button-time, 450ms) var(--m-button-ease, cubic-bezier(.22, 1, .36, 1)),
      color var(--m-button-time, 450ms) var(--m-button-ease, cubic-bezier(.22, 1, .36, 1));
  }
  .btn--secondary .btn__count { transition: color var(--m-button-time, 450ms) var(--m-button-ease, cubic-bezier(.22, 1, .36, 1)); }

  /* ---------- Hover (real pointers only) + keyboard focus ---------- */
  /* Primary (Figma "Primary · Medium · Hover · Hug", 2026-11-09): background turns
     --button-primary-bg-hover, the square chip moves to the right edge (4px inset) and, on hug
     buttons, the label slides left to 12px from the edge. Full-width buttons keep the label centred.
     Plain secondary turns the same red with white text.
     Secondary-chip keeps the original sweep (not used on the site at the moment). */
  .btn--primary:focus-visible { background: var(--button-primary-bg-hover); }
  .btn--primary:focus-visible .btn__chip { left: calc(100% - 36px); }
  .btn--primary.btn--sm:focus-visible .btn__chip { left: calc(100% - 32px); }
  .btn--primary.btn--hug:focus-visible .btn__label { translate: -32px 0; }
  .btn--primary.btn--hug.btn--sm:focus-visible .btn__label { translate: -28px 0; }
  .btn--secondary-chip:focus-visible .btn__chip { width: calc(100% - 6px); }
  .btn--secondary-chip.btn--hug:focus-visible :is(.btn__label, .btn__count) { translate: -24px 0; }
  .btn--secondary:focus-visible {
    background: var(--button-primary-bg-hover);
    border-color: var(--button-primary-bg-hover);
    color: var(--button-primary-text);
  }
  .btn--secondary:focus-visible .btn__count { color: var(--button-primary-text); opacity: 0.72; }

  @media (hover: hover) and (pointer: fine) {
    .btn--primary:hover { background: var(--button-primary-bg-hover); }
    .btn--primary:hover .btn__chip { left: calc(100% - 36px); }
    .btn--primary.btn--sm:hover .btn__chip { left: calc(100% - 32px); }
    .btn--primary.btn--hug:hover .btn__label { translate: -32px 0; }
    .btn--primary.btn--hug.btn--sm:hover .btn__label { translate: -28px 0; }
    .btn--secondary-chip:hover .btn__chip { width: calc(100% - 6px); }
    .btn--secondary-chip.btn--hug:hover :is(.btn__label, .btn__count) { translate: -24px 0; }
    .btn--secondary:hover {
      background: var(--button-primary-bg-hover);
      border-color: var(--button-primary-bg-hover);
      color: var(--button-primary-text);
    }
    .btn--secondary:hover .btn__count { color: var(--button-primary-text); opacity: 0.72; }
  }
</style>
