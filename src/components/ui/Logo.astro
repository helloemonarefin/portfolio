---
/**
 * Brand: logo mark (32×32, from Figma) + "Emon Arefin" wordmark in h5.
 * The mark uses currentColor so it follows --text-primary.
 */
interface Props {
  href?: string;
  class?: string;
}
const { href, class: className } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class:list={['brand', className]} href={href} aria-label={href ? 'Emon Arefin — home' : undefined}>
  <svg class="brand__mark" width="32" height="32" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
    <path
