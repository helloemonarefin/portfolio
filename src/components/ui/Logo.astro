    ></path>
  </svg>
  <span class="brand__name t-h5">Emon Arefin</span>
</Tag>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11.636px; /* Figma */
    color: var(--text-primary);
    text-decoration: none;
  }
  .brand__mark { flex: none; }
  .brand__name { white-space: nowrap; letter-spacing: 0; }
</style>
