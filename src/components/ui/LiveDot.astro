---
/**
 * Live Dot — DESIGN_SYSTEM.md §5.13. Figma: Live Dot (Tone = Green | Dark).
 * 24×24 box, 10px core. The pulsing halo (10 → 24px, 45% → 0, 1.4s) is added in Phase 7.
 */
interface Props {
  tone?: 'green' | 'dark';
  class?: string;
}
const { tone = 'green', class: className } = Astro.props;
---

<span class:list={['live-dot', `live-dot--${tone}`, className]} aria-hidden="true">
  <span class="live-dot__halo"></span>
  <span class="live-dot__core"></span>
</span>

<style>
  .live-dot {
    position: relative;
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 24px;
    height: 24px;
    --dot: var(--status-live);
  }
  .live-dot--dark { --dot: var(--text-primary); }

  .live-dot__core,
  .live-dot__halo {
    grid-area: 1 / 1;
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--dot);
  }
  .live-dot__halo { opacity: 0; } /* animated in Phase 7 */
</style>
