---
/**
 * Live Dot — DESIGN_SYSTEM.md §5.13. Figma: Live Dot (Tone = Green | Dark).
 * 24×24 box, 10px core + a halo that grows 10 → 24px while fading 45% → 0 over 1.4s, looping.
 * Static under reduced motion (the global rule stops the loop; the halo ends invisible).
 */
interface Props {
  tone?: 'green' | 'dark';
  class?: string;
}
const { tone = 'green', class: className } = Astro.props;
---

<span class:list={['live-dot', `live-dot--${tone}`, className]} aria-hidden="true">
  <span class="live-dot__halo"></span>
  <span class="live-dot__core"></span>
</span>

<style>
  .live-dot {
    position: relative;
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 24px;
    height: 24px;
    --dot: var(--status-live);
  }
  .live-dot--dark { --dot: var(--text-primary); }

  .live-dot__core,
  .live-dot__halo {
    grid-area: 1 / 1;
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--dot);
  }
  .live-dot__halo { animation: live-dot-pulse 1.4s ease-out infinite; }
  @keyframes live-dot-pulse {
    from { transform: scale(1); opacity: 0.45; }
    to { transform: scale(2.4); opacity: 0; } /* 10px × 2.4 = 24px */
  }
</style>
