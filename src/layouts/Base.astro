---
/**
 * Base layout — wraps every page.
 * Loads the global styles and the self-hosted Inter font (400 + 500 only).
 * SEO / Open Graph tags get filled from the CMS settings in a later phase.
 */
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/typography.css';
import '../styles/global.css';
import { motionCss } from '../lib/motion';
import { designCss } from '../lib/design';

interface Props {
  title: string;
  description?: string;
  /** Hide the page from search engines (e.g. the temporary /styleguide). */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
// Animation timings & curves from Keystatic → Motion.
const motionVars = await motionCss();
// Colours, border weights and hero layout from Keystatic → Design.
const designVars = await designCss();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <!-- Scroll reveals are only armed when motion is allowed (no flash of hidden content otherwise). -->
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('reveal-on');
    </script>
    <style is:inline set:html={motionVars}></style>
    <style is:inline set:html={designVars}></style>
    <Font
      cssVariable="--font-inter"
      preload={[
        { weight: 400, style: 'normal', subset: 'latin' },
        { weight: 500, style: 'normal', subset: 'latin' },
      ]}
    />
  </head>
  <body id="top">
    <slot />
    <script>
      import { initScroll } from '../scripts/scroll';
      import { initReveal } from '../scripts/reveal';
      initScroll();
      initReveal();

      // Reduced motion: background videos don't autoplay (DESIGN_SYSTEM §0 rule 5).
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((v) => {
          v.removeAttribute('autoplay');
          v.pause();
        });
      }
    </script>
  </body>
</html>
