---
/**
 * Base layout — wraps every page.
 * Loads the global styles and the self-hosted Inter font (400 + 500 only).
 * SEO / Open Graph tags get filled from the CMS settings in a later phase.
 */
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/typography.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Hide the page from search engines (e.g. the temporary /styleguide). */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <Font
      cssVariable="--font-inter"
      preload={[
        { weight: 400, style: 'normal', subset: 'latin' },
        { weight: 500, style: 'normal', subset: 'latin' },
      ]}
    />
  </head>
  <body id="top">
    <slot />
  </body>
</html>
